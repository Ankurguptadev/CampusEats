        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\nUSERS ||--o{ FIELDS : owns\n\nFIELDS ||--o{ SOIL_TESTS : has\n\nFIELDS ||--o{ SATELLITE_ANALYSIS : contains\n\nFIELDS ||--o{ RECOMMENDATIONS : receives\n\nFIELDS ||--o{ REPORTS : generates\n\nFIELDS ||--o{ WEATHER_DATA : records\n\n\nUSERS {\n    int user_id PK\n    string name\n    string email\n    string password\n    string role\n    string phone\n}\n\nFIELDS {\n    int field_id PK\n    int farmer_id FK\n    string field_name\n    float area_hectares\n    float latitude\n    float longitude\n    text boundary\n    string image_url\n}\n\nSOIL_TESTS {\n    int soil_test_id PK\n    int field_id FK\n    float ph\n    float nitrogen\n    float phosphorus\n    float potassium\n    float organic_carbon\n    float moisture\n    date sample_date\n}\n\nSATELLITE_ANALYSIS {\n    int analysis_id PK\n    int field_id FK\n    float ndvi\n    float evi\n    float ndwi\n    float soil_moisture\n    float vegetation_coverage\n    date analysis_date\n}\n\nRECOMMENDATIONS {\n    int recommendation_id PK\n    int field_id FK\n    float soil_health_score\n    string recommended_crop\n    string recommended_fertilizer\n    string irrigation_advice\n}\n\nREPORTS {\n    int report_id PK\n    int field_id FK\n    string report_url\n    date generated_at\n}\n\nWEATHER_DATA {\n    int weather_id PK\n    int field_id FK\n    float temperature\n    float humidity\n    float rainfall\n    date record_date\n}\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="BzSqnJNpvb40Otf7kCrq-1">
